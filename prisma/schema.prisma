// 404 Legends — Prisma schema
// Phase 2: full data model + RLS (نقطة 2).
//
// Money rules (نقطة 0):
//  - every monetary column is Decimal(14,2)
//  - exchange_rate_to_egp is Decimal(18,6) (rate, not an amount)
//  - amount_egp is computed and frozen at insert time, never recomputed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Currency {
  EGP
  USD
  SAR
}

enum TransactionType {
  income
  expense
  discount
  refund
  adjustment
}

enum ExpenseType {
  project
  company
}

enum ClientStatus {
  active
  inactive
}

// ─────────────────────────── Users ───────────────────────────

/// Mirrors Supabase auth.users. `id` equals auth.uid().
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  role         String   @default("admin")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at")

  clientsCreated    Client[]           @relation("ClientCreatedBy")
  projectsCreated   Project[]          @relation("ProjectCreatedBy")
  filesUploaded     ProjectFile[]      @relation("FileUploadedBy")
  transactions      Transaction[]      @relation("TransactionCreatedBy")
  payments          Payment[]          @relation("PaymentCreatedBy")
  expenses          Expense[]          @relation("ExpenseCreatedBy")
  auditLogs         AuditLog[]
  meetings          Meeting[]          @relation("MeetingCreatedBy")
  meetingsAssigned  Meeting[]          @relation("MeetingAssignedTo")
  milestones        ProjectMilestone[] @relation("MilestoneCreatedBy")
  reminders         Reminder[]         @relation("ReminderCreatedBy")
  remindersAssigned Reminder[]         @relation("ReminderAssignedTo")
  notifications     Notification[]
  alertDismissals   AlertDismissal[]
  reportPresets     ReportPreset[]

  employeesCreated        Employee[]            @relation("EmployeeCreatedBy")
  employeeProfile         Employee?             @relation("EmployeeUser")
  projectAssignments      ProjectAssignment[]   @relation("AssignmentUser")
  assignmentsCreated      ProjectAssignment[]   @relation("AssignmentCreatedBy")
  employeePaymentsCreated EmployeePayment[]     @relation("EmployeePaymentCreatedBy")
  companyAccountEntries   CompanyAccountEntry[] @relation("CompanyAccountCreatedBy")
  targetClientsCreated    TargetClient[]        @relation("TargetClientCreatedBy")

  @@map("users")
}

// ────────────────────────── Clients ──────────────────────────

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  companyName String?      @map("company_name")
  phone       String?
  email       String?
  address     String?
  notes       String?
  status      ClientStatus @default(active)
  createdBy   String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  creator      User?         @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  projects     Project[]
  transactions Transaction[]
  payments     Payment[]
  meetings     Meeting[]
  reminders    Reminder[]

  @@index([status])
  @@map("clients")
}

// ────────────────────────── Projects ─────────────────────────

model Project {
  id                   String    @id @default(uuid()) @db.Uuid
  clientId             String    @map("client_id") @db.Uuid
  name                 String
  description          String?
  status               String    @default("Planning")
  startDate            DateTime? @map("start_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  actualDeliveryDate   DateTime? @map("actual_delivery_date") @db.Date
  contractValue        Decimal   @default(0) @map("contract_value") @db.Decimal(14, 2)
  discount             Decimal   @default(0) @db.Decimal(14, 2)
  notes                String?
  createdBy            String?   @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  creator          User?               @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  files            ProjectFile[]
  transactions     Transaction[]
  payments         Payment[]
  expenses         Expense[]
  meetings         Meeting[]
  milestones       ProjectMilestone[]
  reminders        Reminder[]
  assignments      ProjectAssignment[]
  employeePayments EmployeePayment[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

// ─────────────────────── Project files ───────────────────────

model ProjectFile {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  fileName   String   @map("file_name")
  storageKey String   @map("storage_key")
  fileType   String   @map("file_type")
  fileSize   Int      @map("file_size")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User?   @relation("FileUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_files")
}

// ─────────────────────── Transactions ────────────────────────

/// Central ledger — every money movement creates one row here.
model Transaction {
  id                String          @id @default(uuid()) @db.Uuid
  type              TransactionType
  amountOriginal    Decimal         @map("amount_original") @db.Decimal(14, 2)
  currency          Currency
  exchangeRateToEgp Decimal         @map("exchange_rate_to_egp") @db.Decimal(18, 6)
  amountEgp         Decimal         @map("amount_egp") @db.Decimal(14, 2)
  date              DateTime        @db.Date
  description       String?
  clientId          String?         @map("client_id") @db.Uuid
  projectId         String?         @map("project_id") @db.Uuid
  category          String?
  paymentMethod     String?         @map("payment_method")
  notes             String?
  createdBy         String?         @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  client              Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator             User?                @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  payment             Payment?
  expense             Expense?
  employeePayment     EmployeePayment?
  companyAccountEntry CompanyAccountEntry?

  @@index([projectId])
  @@index([clientId])
  @@index([type])
  @@index([date])
  @@map("transactions")
}

// ───────────────────────── Payments ──────────────────────────

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  transactionId     String   @unique @map("transaction_id") @db.Uuid
  amountOriginal    Decimal  @map("amount_original") @db.Decimal(14, 2)
  currency          Currency
  exchangeRateToEgp Decimal  @map("exchange_rate_to_egp") @db.Decimal(18, 6)
  amountEgp         Decimal  @map("amount_egp") @db.Decimal(14, 2)
  method            String?
  date              DateTime @db.Date
  referenceNumber   String?  @map("reference_number")
  notes             String?
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  creator     User?       @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([clientId])
  @@map("payments")
}

// ───────────────────────── Expenses ──────────────────────────

model Expense {
  id                String      @id @default(uuid()) @db.Uuid
  type              ExpenseType
  projectId         String?     @map("project_id") @db.Uuid
  categoryId        String      @map("category_id") @db.Uuid
  transactionId     String      @unique @map("transaction_id") @db.Uuid
  amountOriginal    Decimal     @map("amount_original") @db.Decimal(14, 2)
  currency          Currency
  exchangeRateToEgp Decimal     @map("exchange_rate_to_egp") @db.Decimal(18, 6)
  amountEgp         Decimal     @map("amount_egp") @db.Decimal(14, 2)
  date              DateTime    @db.Date
  description       String?
  paymentMethod     String?     @map("payment_method")
  notes             String?
  createdBy         String?     @map("created_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")

  project     Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  creator     User?           @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([categoryId])
  @@index([type])
  @@map("expenses")
}

// ─────────────────── Reference / lookup tables ───────────────

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  expenses  Expense[]

  @@map("expense_categories")
}

model ProjectStatus {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  sortOrder Int      @map("sort_order")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("project_statuses")
}

model PaymentMethod {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("payment_methods")
}

// ───────────────────────── Audit log ────────────────────────

/// Append-only. Never deleted from the UI.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Settings ─────────────────────────

model Setting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  value String

  @@map("settings")
}

// ═══════════════════ Phase 2: Calendar / Meetings / Timeline / Notifications ═══════════════════
//
// All timestamps stored in UTC, displayed in Africa/Cairo.

enum MeetingType {
  call
  onsite
  online
}

enum MeetingStatus {
  scheduled
  done
  cancelled
}

/// Meetings/calls, optionally tied to a client and/or project.
model Meeting {
  id               String        @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  meetingAt        DateTime      @map("meeting_at")
  durationMinutes  Int?          @map("duration_minutes")
  location         String?
  type             MeetingType   @default(call)
  status           MeetingStatus @default(scheduled)
  clientId         String?       @map("client_id") @db.Uuid
  projectId        String?       @map("project_id") @db.Uuid
  assignedToUserId String?       @map("assigned_to_user_id") @db.Uuid
  createdBy        String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator    User?      @relation("MeetingCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("MeetingAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  reminders  Reminder[]

  @@index([meetingAt])
  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([assignedToUserId])
  @@map("meetings")
}

/// Ordered milestones forming a project's timeline.
model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User?   @relation("MilestoneCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([projectId, sortOrder])
  @@index([dueDate])
  @@map("project_milestones")
}

/// Manual reminders, optionally linked to a client / project / meeting.
model Reminder {
  id               String    @id @default(uuid()) @db.Uuid
  title            String
  note             String?
  remindAt         DateTime  @map("remind_at")
  doneAt           DateTime? @map("done_at")
  clientId         String?   @map("client_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  meetingId        String?   @map("meeting_id") @db.Uuid
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  creator    User?    @relation("ReminderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("ReminderAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([remindAt])
  @@index([doneAt])
  @@index([assignedToUserId])
  @@map("reminders")
}

/// Records that a user dismissed a live-computed alert. `alertKey` is a
/// stable string like "delivery-soon:{projectId}"; if the underlying
/// condition changes the key changes and the alert reappears.
model AlertDismissal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  alertKey    String   @map("alert_key")
  dismissedAt DateTime @default(now()) @map("dismissed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alertKey])
  @@map("alert_dismissals")
}

/// Discrete in-app notifications for a specific user.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// Per-user saved report filters (Phase 3 نقطة 3.5).
model ReportPreset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  filters    Json
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, lastUsedAt])
  @@map("report_presets")
}

// ═══════════════════ Phase 4: Employees / Payroll / Company account ═══════════════════
//
// Employees are admin-managed records. As of Phase 5 an Employee MAY have a
// linked `User` login (Employee.userId) — an employee portal account created
// by an admin, reusing the same Supabase admin.auth.admin.createUser flow as
// createAdminAction, with role "employee". Employee.userId is optional: an
// Employee with no login is still a valid record (CV/payroll/rating only).
// Every EmployeePayment and CompanyAccountEntry hangs off the central
// `Transaction` ledger 1:1, exactly like Payment / Expense. Decision: employee
// money always comes from a project's budget (recorded as an Expense of type
// `project`).

enum EmployeeStatus {
  active
  inactive
}

enum AssignmentRole {
  employee
  supervisor
}

enum EmployeePayType {
  commission
  fixed
  bonus
  deduction
}

enum CompanyAccountDirection {
  deposit
  withdrawal
}

/// A company employee (not a system user). Managed from /employees by admins.
model Employee {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  age           Int?
  country       String?
  governorate   String?
  phone         String?
  qualification String?
  cvStorageKey  String?        @map("cv_storage_key")
  cvFileName    String?        @map("cv_file_name")
  rating        Int?           @default(0) // 1..10, clamped in the app
  status        EmployeeStatus @default(active)
  notes         String?
  userId        String?        @unique @map("user_id") @db.Uuid
  createdBy     String?        @map("created_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  creator                User?                  @relation("EmployeeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  user                   User?                  @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  assignments            ProjectAssignment[]
  payments               EmployeePayment[]
  claimedTargetClients   TargetClient[]         @relation("TargetClientClaimedBy")
  targetClientActivities TargetClientActivity[]

  @@index([status])
  @@map("employees")
}

/// Links a project to a person working on it — an `Employee` (role=employee)
/// or a system `User` / supervisor (role=supervisor). Exactly one of
/// employeeId / userId is set, matching `role` (enforced in the app).
model ProjectAssignment {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @map("project_id") @db.Uuid
  employeeId String?        @map("employee_id") @db.Uuid
  userId     String?        @map("user_id") @db.Uuid
  role       AssignmentRole
  assignedAt DateTime       @default(now()) @map("assigned_at")
  createdBy  String?        @map("created_by") @db.Uuid

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user     User?     @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  creator  User?     @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([projectId, employeeId])
  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_assignments")
}

/// A salary / commission / bonus / deduction for an employee, always tied to a
/// project's budget. 1:1 with a `Transaction` like Payment / Expense.
model EmployeePayment {
  id                String          @id @default(uuid()) @db.Uuid
  employeeId        String          @map("employee_id") @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  transactionId     String          @unique @map("transaction_id") @db.Uuid
  payType           EmployeePayType @map("pay_type")
  amountOriginal    Decimal         @map("amount_original") @db.Decimal(14, 2)
  currency          Currency
  exchangeRateToEgp Decimal         @map("exchange_rate_to_egp") @db.Decimal(18, 6)
  amountEgp         Decimal         @map("amount_egp") @db.Decimal(14, 2)
  date              DateTime        @db.Date
  notes             String?
  createdBy         String?         @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  creator     User?       @relation("EmployeePaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([projectId])
  @@map("employee_payments")
}

/// The company's internal wallet. Balance = Σ deposits − Σ withdrawals (EGP).
/// Fed only by manual entries. 1:1 with a `Transaction`.
model CompanyAccountEntry {
  id                String                  @id @default(uuid()) @db.Uuid
  direction         CompanyAccountDirection
  transactionId     String                  @unique @map("transaction_id") @db.Uuid
  amountOriginal    Decimal                 @map("amount_original") @db.Decimal(14, 2)
  currency          Currency
  exchangeRateToEgp Decimal                 @map("exchange_rate_to_egp") @db.Decimal(18, 6)
  amountEgp         Decimal                 @map("amount_egp") @db.Decimal(14, 2)
  date              DateTime                @db.Date
  reason            String?
  createdBy         String?                 @map("created_by") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  creator     User?       @relation("CompanyAccountCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([direction])
  @@index([date])
  @@map("company_account_entries")
}

// ═══════════════════ Phase 5: Target clients (leads) ═══════════════════
//
// A TargetClient is a lead — a company the sales team is trying to close,
// separate from `Client` (an already-signed client). An Employee "claims"
// an available one to work it; a lost deal does NOT return to the pool
// automatically (decision, 2026-09-11) — it stays claimed, visibly marked
// lost, until an admin explicitly unassigns it (clears claimedById, reopens
// status to available). TargetClientActivity is a single unified timeline
// for notes/reports/voice-calls, ordered by createdAt. Voice-call fields
// (driveFileId/driveWebLink/durationSeconds) are reserved now but the
// Google Drive upload flow itself is postponed — not built in Phase 5.4.

enum TargetClientStatus {
  available
  claimed
  won
  lost
  inactive
}

enum TargetClientActivityKind {
  note
  report
  voice_call
}

model TargetClient {
  id            String             @id @default(uuid()) @db.Uuid
  companyName   String             @map("company_name")
  contactPhones String[]           @map("contact_phones")
  socialLinks   Json?              @map("social_links")
  website       String?
  companySize   String?            @map("company_size")
  script        String?
  notes         String?
  status        TargetClientStatus @default(available)
  hidden        Boolean            @default(false) @map("hidden_from_employees")
  claimedById   String?            @map("claimed_by_id") @db.Uuid
  claimedAt     DateTime?          @map("claimed_at")
  closedAt      DateTime?          @map("closed_at")
  createdBy     String?            @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  claimedBy  Employee?              @relation("TargetClientClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  creator    User?                  @relation("TargetClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  activities TargetClientActivity[]

  @@index([status])
  @@index([hidden])
  @@index([claimedById])
  @@map("target_clients")
}

model TargetClientActivity {
  id              String                   @id @default(uuid()) @db.Uuid
  targetClientId  String                   @map("target_client_id") @db.Uuid
  employeeId      String?                  @map("employee_id") @db.Uuid
  kind            TargetClientActivityKind
  body            String?
  fileStorageKey  String?                  @map("file_storage_key")
  fileName        String?                  @map("file_name")
  driveFileId     String?                  @map("drive_file_id")
  driveWebLink    String?                  @map("drive_web_link")
  durationSeconds Int?                     @map("duration_seconds")
  createdAt       DateTime                 @default(now()) @map("created_at")

  targetClient TargetClient @relation(fields: [targetClientId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([targetClientId])
  @@index([kind])
  @@map("target_client_activities")
}
