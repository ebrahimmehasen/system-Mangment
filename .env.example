# ─────────────────────────────────────────────────────────────
# 404 Legends — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real secrets.
# ─────────────────────────────────────────────────────────────

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings (Supabase → Connect → ORM → Prisma)
# DATABASE_URL: transaction-mode pooler (port 6543) — app runtime
# DIRECT_URL:   session-mode pooler (port 5432) — Prisma migrations
# URL-encode special characters in the password (@ -> %40, # -> %23, $ -> %24, ...)
DATABASE_URL=
DIRECT_URL=

# App
APP_URL=http://localhost:3000

# Uploads
MAX_PROJECT_FILE_SIZE=10485760

# Currency
DEFAULT_CURRENCY=EGP
